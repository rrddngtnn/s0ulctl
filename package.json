{
  "name": "s0ulctl",
  "version": "0.1.0",
  "description": "Replace 9router's hardcoded upstream system prompts with your own markdown.",
  "license": "MIT",
  "bin": {
    "s0ulctl": "bin/s0ulctl.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint:shell": "shellcheck src/*.sh",
    "check": "node --check src/soul-loader.cjs && bash -n src/install.sh && bash -n src/uninstall.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrddngtnn/s0ulctl.git"
  },
  "keywords": [
    "9router",
    "system-prompt",
    "llm",
    "proxy",
    "patch"
  ]
}
